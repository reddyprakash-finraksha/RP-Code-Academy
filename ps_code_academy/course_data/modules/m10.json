 "quiz": [
  {
   "question": "How do you read a value safely with a default?",
   "options": [
    "d[key]",
    "d.get(key, default)",
    "d.read(key)",
    "d.find(key)"
   ],
   "answer": 1,
   "explanation": "get() avoids a KeyError."
  },
  {
