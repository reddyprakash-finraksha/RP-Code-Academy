 "quiz": [
  {
   "question": "Which is a valid variable name?",
   "options": [
    "2nd_place",
    "my score",
    "my_score",
    "my-score"
   ],
   "answer": 2,
   "explanation": "Names use letters, digits and underscores, and cannot start with a digit."
  },
  {
   "question": "What is type(3.0)?",
   "options": [
    "int",
    "float",
    "str",
    "bool"
   ],
   "answer": 1,
   "explanation": "Numbers with a decimal point are floats."
  },
  {
   "question": "What does int(7.9) give?",
   "options": [
    "8",
    "7.9",
    "7",
    "Error"
   ],
   "answer": 2,
   "explanation": "int() cuts off the decimal part."
  },
  {
   "question": "What is bool('')?",
   "options": [
    "True",
    "False",
    "Error",
    "None"
   ],
   "answer": 1,
   "explanation": "An empty string is False."
  }
