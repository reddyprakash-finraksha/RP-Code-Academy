 "lessons": [
  {
   "id": "m05-l1",
   "title": "Reading Input",
   "exercises": [
    {
     "id": "m05-l1-e1",
     "title": "Greeting",
     "prompt": "Read a name and print `Hello, <name>!`.",
     "starter": "# Write your code below\n",
     "hints": [
      "name = input()",
      "Join the pieces with +."
     ],
     "solution": "name = input()\nprint(\"Hello, \" + name + \"!\")\n",
     "tests": [
      {
       "input": "Asha\n",
       "expected": "Hello, Asha!\n"
      },
      {
       "input": "Ravi\n",
       "expected": "Hello, Ravi!\n"
      }
     ]
    },
    {
     "id": "m05-l1-e2",
     "title": "Last, First",
     "prompt": "Read a first name, then a last name (two lines). Print `<last>, <first>`.",
     "starter": "# Write your code below\n",
     "hints": [
      "Two input() calls."
     ],
     "solution": "first = input()\nlast = input()\nprint(last + \", \" + first)\n",
     "tests": [
      {
       "input": "Asha\nRao\n",
       "expected": "Rao, Asha\n"
      },
      {
       "input": "Ravi\nKumar\n",
       "expected": "Kumar, Ravi\n"
      }
     ]
    },
    {
     "id": "m05-l1-e3",
     "title": "Double It",
     "prompt": "Read an integer and print it doubled.",
     "starter": "# Write your code below\n",
     "hints": [
      "Convert with int()."
     ],
     "solution": "n = int(input())\nprint(n * 2)\n",
     "tests": [
      {
       "input": "4\n",
       "expected": "8\n"
      },
      {
       "input": "21\n",
       "expected": "42\n"
      },
      {
       "input": "-3\n",
       "expected": "-6\n"
      }
     ]
    }
   ]
  },
  {
   "id": "m05-l2",
   "title": "f-Strings",
   "exercises": [
    {
     "id": "m05-l2-e1",
     "title": "Next Year",
     "prompt": "Read a name, then an age (integer). Print `<name> will be <age+1> next year.`",
     "starter": "# Write your code below\n",
     "hints": [
      "age + 1 inside {}"
     ],
     "solution": "name = input()\nage = int(input())\nprint(f\"{name} will be {age + 1} next year.\")\n",
     "tests": [
      {
       "input": "Asha\n15\n",
       "expected": "Asha will be 16 next year.\n"
      },
      {
       "input": "Ravi\n20\n",
       "expected": "Ravi will be 21 next year.\n"
      }
     ]
    },
    {
     "id": "m05-l2-e2",
     "title": "Price",
     "prompt": "Set `price = 3.5` and print `Price: Rs 3.50` (two decimals).",
     "starter": "# Write your code below\n",
     "hints": [
      ":.2f gives two decimals."
     ],
     "solution": "price = 3.5\nprint(f\"Price: Rs {price:.2f}\")\n",
     "tests": [
      {
       "input": "",
       "expected": "Price: Rs 3.50\n"
      }
     ]
    },
    {
     "id": "m05-l2-e3",
     "title": "Square",
     "prompt": "Read an integer n and print `<n> squared is <n squared>`.",
     "starter": "# Write your code below\n",
     "hints": [
      "n ** 2"
     ],
     "solution": "n = int(input())\nprint(f\"{n} squared is {n ** 2}\")\n",
     "tests": [
      {
       "input": "5\n",
       "expected": "5 squared is 25\n"
      },
      {
       "input": "12\n",
       "expected": "12 squared is 144\n"
      }
     ]
    }
   ]
  },
  {
