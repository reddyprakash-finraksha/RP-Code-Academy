     "title": "Thousands",
     "prompt": "Print `1234567` with commas: `1,234,567`.",
     "starter": "# Write your code below\n",
     "hints": [
      ":, in the braces."
     ],
     "solution": "print(f\"{1234567:,}\")\n",
     "tests": [
      {
       "input": "",
       "expected": "1,234,567\n"
      }
     ]
    },
    {
     "id": "m05-l3-e2",
     "title": "Percent",
     "prompt": "Print `0.256` as a percentage with one decimal: `25.6%`.",
     "starter": "# Write your code below\n",
     "hints": [
      ":.1%"
     ],
     "solution": "print(f\"{0.256:.1%}\")\n",
     "tests": [
      {
       "input": "",
       "expected": "25.6%\n"
      }
     ]
    },
    {
     "id": "m05-l3-e3",
     "title": "Table Header",
     "prompt": "Print `Name` left-aligned in 10 characters, then `|`, then `Age` right-aligned in 5 characters, using one f-string.",
     "starter": "# Write your code below\n",
     "hints": [
      "{'Name':<10}",
      "{'Age':>5}"
     ],
     "solution": "print(f\"{'Name':<10}|{'Age':>5}\")\n",
     "tests": [
      {
       "input": "",
       "expected": "Name      |  Age\n"
      }
     ]
    },
    {
     "id": "m05-l3-e4",
     "title": "Add Two Numbers",
     "prompt": "Read two integers (one per line) and print `a + b = total`, for example `3 + 4 = 7`.",
     "starter": "# Write your code below\n",
     "hints": [
      "Use an f-string with three parts."
     ],
     "solution": "a = int(input())\nb = int(input())\nprint(f\"{a} + {b} = {a + b}\")\n",
     "tests": [
      {
       "input": "3\n4\n",
       "expected": "3 + 4 = 7\n"
      },
      {
       "input": "10\n-2\n",
       "expected": "10 + -2 = 8\n"
      }
     ]
    }
   ]
  }
 ],
 "quiz": [
  {
